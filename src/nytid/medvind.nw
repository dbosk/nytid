def test_make_session_follows_the_whole_chain(monkeypatch):
  monkeypatch.setenv("WEBLOGIN_MFA_NOTIFICATION", "true")
  mfa_page = page(
    '<form id="loginForm" method="post" action="/mfa">'
    '<input name="AuthMethod" value="AzureMfaAuthentication">'
    '<input name="Context" value="ctx"></form>'
    '<p id="validEntropyNumber">33</p>')
  routes = {
    "/start": lambda h, b: relay_page("/idp", field="SAMLRequest"),
    "/idp": lambda h, b: page(
      f'<form id="loginForm" method="post" '
      f'action="http://{h.headers["Host"]}/idp/password">'
      '<input name="UserName"><input name="Password" type="password">'
      '</form>'),
    "/idp/password": lambda h, b: mfa_page,
    "/mfa": lambda h, b: relay_page("/sp", field="SAMLResponse"),
    "/sp": lambda h, b: relay_page("/app", field="wresult"),
    "/app": lambda h, b: page("<html>attest view</html>"),
