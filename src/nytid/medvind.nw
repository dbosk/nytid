We exercise each criterion on the recorded times.
The personnummer is tried in all four spellings, and a name with a
trailing space tells Tolvan from Tolva, whose name is a prefix of his.
<<test functions>>=
def test_select_by_ta_name_and_personnummer():
  times = TIMELIST_ANSWER["timeapprove"]
  assert len(select(times, ta="tolvan ")) == 2
  assert len(select(times, ta="Tolva")) == 4
  for spelling in ["19121212-1212", "191212121212",
                   "121212-1212", "1212121212"]:
    assert {full_name(r) for r in select(times, ta=spelling)} \
      == {"Tolvan Tolvansson"}

def test_select_by_leader_comment_and_attestation():
  times = TIMELIST_ANSWER["timeapprove"]
  assert len(select(times, leader="ada")) == 2
  assert len(select(times, comment="dd1301")) == 2
  assert [r["datum"] for r in select(times, attested=False)] \
    == ["2026-09-01"]
  assert len(select(times, attested=True)) == 3
  assert select(times, ta="Tolva ", comment="DD1301",
                attested=True) == []
