    "Student(165)", "DD1301 labbpass", "Ada Lärare", "A", "JXX,110210,")
  assert record_to_row(second)[6] == "DD1310 handledning 2h schablon"
  assert record_to_row(second)[9] == "JXX,110210,"
  assert record_to_row(third)[4] == "4"
  assert record_to_row(fourth)[6:] == ("", "", "A", "")
  assert all(len(record_to_row(r)) == len(ROW_COLUMNS)
             for r in TIMELIST_ANSWER["timeapprove"])
