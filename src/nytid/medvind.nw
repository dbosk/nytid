    raise weblogin.AuthenticationError(
        f"Medvind sign-on relayed more than {MAX_RELAY_DEPTH} times "
        f"without reaching Medvind, last at {response.url}"
    )
<<refuse to relay to an unsafe target>>=
if not safe_relay_target(response.url, url, self.__hosts):
    raise weblogin.AuthenticationError(
        f"refusing to relay a sign-on token from {response.url} to {url}"
    )
<<functions>>=
def has_password_form(response):
    """Return True if `response` shows a form asking for a password."""
    if "html" not in response.headers.get("Content-Type", ""):
        return False
    try:
        tree = html.fromstring(response.content)
    except (etree.ParserError, ValueError):
        return False
    return bool(tree.xpath("//form//input[@name='Password']"))
@

