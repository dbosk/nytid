def medvind_routes(sso_cookie="sso-abc"):
  """Routes that mimic the attest view and Medvind's data API."""
  def attest_view(handler, body):
    headers = [("Content-Type", "text/html")]
    if sso_cookie:
      headers.append(("Set-Cookie",
                      f"{SSO_COOKIE}={sso_cookie}; path=/"))
    return 200, headers, "<html>attest view</html>"

  def data_api(handler, body):
    answers = {"CREATE": SESSION_ANSWER,
               "LOAD_TIMELIST": TIMELIST_ANSWER}
    func = urllib.parse.parse_qs(handler.path.partition("?")[2])["FUNC"][0]
    return (200, [("Content-Type", "application/json")],
            json.dumps(answers[func]))

  return {"/MvWeb.aspx": attest_view, "/MvData.aspx": data_api}
