  assert password_post["UserName"] == ["tolvan@ug.kth.se"]
  assert password_post["Password"] == ["secret"]
  assert urllib.parse.parse_qs(received[3]["body"])["Context"] == ["ctx"]
  assert all(r["headers"]["User-Agent"] == USER_AGENT for r in received)
  assert urllib.parse.parse_qs(received[4]["body"])["SAMLResponse"] \
    == ["token-123"]
