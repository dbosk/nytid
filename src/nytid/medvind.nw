<<test helpers>>=
@contextlib.contextmanager
def local_server(routes):
  """Serve `routes` on a free loopback port; yield (url, requests)."""
  received = []

  class Handler(http.server.BaseHTTPRequestHandler):
    def handle_any(self):
      length = int(self.headers.get("Content-Length") or 0)
      body = self.rfile.read(length).decode("utf-8")
      path, _, query = self.path.partition("?")
      received.append({"method": self.command, "path": path,
                       "query": urllib.parse.parse_qs(query),
                       "headers": dict(self.headers), "body": body})
      status, headers, content = routes[path](self, body)
      self.send_response(status)
      for name, value in headers:
        self.send_header(name, value)
      content = content.encode("utf-8")
      self.send_header("Content-Length", str(len(content)))
      self.end_headers()
      self.wfile.write(content)

    do_GET = do_POST = handle_any

    def log_message(self, *args):
      pass

  server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
  thread = threading.Thread(target=server.serve_forever, daemon=True)
  thread.start()
  try:
    yield f"http://127.0.0.1:{server.server_port}", received
  finally:
    server.shutdown()
    server.server_close()

def page(text):
  """A route answer with an HTML page."""
  return 200, [("Content-Type", "text/html; charset=utf-8")], text

def relay_page(action, field="SAMLResponse"):
  """An auto-submitting relay page shaped like the ones in the chain."""
  return page(f'<html><body><form method="POST" name="hiddenform" '
              f'action="{action}"><input type="hidden" name="{field}" '
              f'value="token-123"><input type="hidden" '
              f'name="RelayState" value="state"></form></body></html>')

LOCAL = frozenset({"127.0.0.1"})
@

A relay page is recognised and resolved to the form's target, while
the password and MFA forms are left alone, and so is a response that
is not HTML, even when its body contains a relay form:
<<test functions>>=
def test_relay_form_finds_saml_form():
  with local_server({"/relay": lambda h, b: relay_page("/next")}) as (url, _):
    response = requests.get(url + "/relay")
  method, target, data = relay_form(response)
  assert method == "POST"
  assert target == url + "/next"
  assert data == {"SAMLResponse": "token-123", "RelayState": "state"}

def test_relay_form_ignores_password_mfa_and_non_html():
  login = page('<form id="loginForm" method="post" action="/adfs">'
               '<input name="UserName"><input name="Password"></form>')
  mfa = page('<form id="loginForm" method="post">'
             '<input name="AuthMethod" value="AzureMfaAuthentication">'
             '<input name="Context" value="c"></form>'
             '<p id="validEntropyNumber">33</p>')
  _, _, relay_html = relay_page("/next")
  json_answer = (200, [("Content-Type", "application/json")], relay_html)
  routes = {"/login": lambda h, b: login, "/mfa": lambda h, b: mfa,
            "/json": lambda h, b: json_answer}
  with local_server(routes) as (url, _):
    for path in routes:
      assert relay_form(requests.get(url + path)) is None
