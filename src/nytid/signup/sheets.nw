  content = ("Event,Start,End,Rooms,#Needed TAs,TA\n"
             "Lab,2024-01-01 10:00,2024-01-01 12:00,"
             "D1,1,alice\n")
  with tempfile.NamedTemporaryFile(mode="w", suffix=".csv",
                                   delete=False) as f:
    f.write(content)
