\subsection{Testing [[read_signup_sheet_from_url]]}

As in [[nytid.schedules]], we replace the module-local [[ladok3]]
binding with a [[MagicMock]] rather than patching
[[ladok3.session.session.get]] directly.  The latter would walk the
real [[session.session]] chain on first access and trigger a
credential lookup before the mock took effect; substituting the whole
module attribute redirects every subsequent access to the mock.
<<test functions>>=
def test_read_signup_sheet_from_url():
  from unittest.mock import patch, MagicMock
  csv_text = ("Event,Start,End,Rooms,#Needed TAs,TA\n"
              "Lab,2024-01-01 10:00,2024-01-01 12:00,"
              "D1,1,alice\n")
  mock_resp = MagicMock()
  mock_resp.ok = True
  mock_resp.text = csv_text
  mock_resp.apparent_encoding = "utf-8"
  with patch("nytid.signup.sheets.ladok3") as mock_ladok:
    mock_ladok.session.session.get.return_value = mock_resp
    rows = read_signup_sheet_from_url("https://example.com")
    assert len(rows) == 1

def test_read_signup_sheet_from_url_error():
  from unittest.mock import patch, MagicMock
  import pytest
  mock_resp = MagicMock()
  mock_resp.ok = False
  mock_resp.text = "Forbidden"
  with patch("nytid.signup.sheets.ladok3") as mock_ladok:
    mock_ladok.session.session.get.return_value = mock_resp
    with pytest.raises(ValueError):
      read_signup_sheet_from_url("https://example.com")
