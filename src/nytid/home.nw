The second runs the CLI itself, with [[HOME]] and [[XDG_CONFIG_HOME]]
pointing at directories of their own so that a failure would be visible there
rather than in the user's files, and without the tmux variables so
nothing reaches the user's tmux server.  One command writes the
configuration and one adds a todo; both must land in the home and
nowhere else.

<<test functions>>=
def run_cli_in_fresh_process(env, *args):
    """Run the nytid CLI with `args` in a new interpreter."""
    return subprocess.run(
        [
            sys.executable, "-c",
            "from nytid.cli import cli; cli()",
            *args,
        ],
        env=env, stdin=subprocess.DEVNULL,
        capture_output=True, text=True, timeout=120,
    )


def test_fresh_process_keeps_everything_in_the_home(tmp_path):
    """Config and data of a new process land in NYTID_HOME."""
    sandbox = tmp_path / "nytid-home"
    elsewhere = tmp_path / "home"
    elsewhere.mkdir()
    env = {
        key: value for key, value in os.environ.items()
        if not key.startswith(("TMUX", "XDG_"))
    }
    env.update({
        NYTID_HOME_ENV: str(sandbox),
        "HOME": str(elsewhere),
        "XDG_CONFIG_HOME": str(elsewhere / "xdg"),
        "PYTHONPATH": str(pathlib.Path(nytid.__file__).parents[1]),
    })

    configured = run_cli_in_fresh_process(
        env, "config", "todo.max_boost", "-s", "5"
    )
    assert configured.returncode == 0, configured.stderr
    added = run_cli_in_fresh_process(
        env, "todo", "add", "-t", "From the sandbox"
    )
    assert added.returncode == 0, added.stderr

    assert json.loads(
        (sandbox / "config.json").read_text()
    )["todo"]["max_boost"] == "5"
    todos = (sandbox / "todos" / "todos.json").read_text()
    assert "From the sandbox" in todos
    assert list(elsewhere.iterdir()) == []
