The course is a regex, so it can select several, and leaving it out selects all
of them.
What we have typed of the username still narrows the suggestions in every case.
<<test functions>>=
def test_completing_users_with_course_regex(courses_with_sheets):
  assert complete("hr", "timesheets", "generate", "prg(i|m)",
                  "--register", REGISTER, "--user") == ["olvan", "tolvan"]

def test_completing_users_without_course(courses_with_sheets):
  assert complete("hr", "timesheets", "generate",
                  "--register", REGISTER, "--user") == ["olvan", "tolvan"]
  assert complete("schedule", "view",
                  "--register", REGISTER, "--user") == ["olvan", "tolvan"]

def test_completing_users_never_takes_a_username_for_a_course(
    courses_with_sheets, monkeypatch):
  """Some commands' only positional argument is a username.

  These commands have no --register, so their sheets are found in the default
  register, which we point at ours. The unknown option makes the parser give up
  with the word in the leftovers, as an option waiting for its value does.
  """
  monkeypatch.setattr(signupsheets_module.coursescli, "MINE", REGISTER)
  assert complete("hr", "amanuensis", "view", "prgi",
                  "--no-such-option") == ["olvan", "tolvan"]

def test_completing_users_filters_on_what_is_typed(courses_with_sheets):
  assert complete("hr", "timesheets", "generate", "prg(i|m)",
                  "--register", REGISTER, "--user",
                  incomplete="t") == ["tolvan"]
  assert complete("hr", "timesheets", "generate", "prgi",
                  "--register", REGISTER, "--user",
                  incomplete="o") == []
@

The shells also differ in a way that matters here.
Bash splits [[--user=]] into separate words, so the option is left waiting as
above.
Zsh keeps it in one piece and sends it as the word being completed, so the
parser never sees the option and reaches the end.
That is the only way a [[--user]] completion gets its course from
[[ctx.params]], so we ask in zsh's protocol as well.
Its answer is a line of shell code rather than one name per line, so all we
take from it are the quoted names.
<<test functions>>=
def complete_in_zsh(*words):
  """What zsh would offer after typing `words`, the last being unfinished."""
  result = CliRunner().invoke(nytid_cli, [], prog_name="nytid", env={
    "_NYTID_COMPLETE": "complete_zsh",
    "_TYPER_COMPLETE_ARGS": " ".join(["nytid", *words]),
  })
  assert result.exit_code == 0
  return re.findall(r'"(\w+)"', result.stdout)

@pytest.mark.parametrize("command", [
  ["hr", "timesheets", "generate"],
  ["schedule", "view"],
])
def test_completing_users_after_equals_in_zsh(courses_with_sheets, command):
  assert complete_in_zsh(*command, "prgi",
                         "--register", REGISTER, "--user=") == ["tolvan"]
