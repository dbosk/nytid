READ_OPTIONS = """
import importlib, json, sys
result = []
for module, attribute in json.loads(sys.argv[1]):
  value = getattr(importlib.import_module("nytid.cli." + module), attribute)
  result.append(getattr(value, "value", value))
print(json.dumps(result))
"""

def options_read_from(tmp_path, stored):
  """Return each renamed option as a new process reads it from `stored`."""
  (tmp_path / "config.json").write_text(json.dumps(stored))
  env = {**os.environ, "NYTID_HOME": str(tmp_path)}
  env.pop("TMUX", None)
  env.pop("TMUX_PANE", None)
  asked = [[option[0], option[1]] for option in RENAMED_OPTIONS]
  result = subprocess.run(
    [sys.executable, "-c", READ_OPTIONS, json.dumps(asked)],
    env=env, capture_output=True, text=True,
  )
  assert result.returncode == 0, result.stderr
  return json.loads(result.stdout.splitlines()[-1])

def nested(settings):
  """Turn dotted keys into the nested form of the configuration file."""
  stored = {}
  for key, value in settings.items():
    *sections, name = key.split(".")
    place = stored
    for section in sections:
      place = place.setdefault(section, {})
    place[name] = value
  return stored

def test_old_keys_still_set_every_renamed_option(tmp_path):
  """A configuration from before the rename keeps working."""
  stored = nested({f"{old}.{key}": old_value
                   for _, _, _, old, key, old_value, _ in RENAMED_OPTIONS})
  assert options_read_from(tmp_path, stored) == [
    option[5] for option in RENAMED_OPTIONS]

def test_new_keys_win_for_every_renamed_option(tmp_path):
  """With both names stored, every option takes the current one."""
  settings = {}
  for _, _, current, old, key, old_value, new_value in RENAMED_OPTIONS:
    settings[f"{old}.{key}"] = old_value
    settings[f"{current}.{key}"] = new_value
  assert options_read_from(tmp_path, nested(settings)) == [
    option[6] for option in RENAMED_OPTIONS]
@

\section{Tests}

Tests are tangled into [[tests/test_cliutilsdefaults.py]].
We rely on [[unittest.mock]] to substitute the cached config without
touching the real config file.
Every test resets the cache first, via an autouse fixture, so the
ordering between tests does not matter.
\section{Advertising the key in [[--help]]}
\label{cli.utils.defaults.hint}

Every configurable option ends its help text with the key that
overrides it, [[[config: key]]], so a user can discover the key from
[[--help]] alone (\cref{sec:cli-config-keys}).  Typer renders help
through [[rich]] with markup enabled, and to [[rich]] a bracketed
word is a style tag: [[[config: todo.list.count]]] is silently
consumed as markup, and for a long time the convention advertised
nothing at all.  The remedy is to escape the brackets the way
[[rich]] itself prescribes, with a backslash before the opening one,
which the renderer turns back into the literal text.  Every option
builds its suffix through this one helper, so the escape lives in
exactly one place and cannot be forgotten at the next option.
We spell the backslash ourselves rather than call
[[rich.markup.escape]]: this module is imported by every CLI module
at start-up, and the CLI keeps [[rich]] out of that path
(\cref{climodule}); for one fixed bracket the escape is a literal.

<<config hint helper>>=
def config_hint(key):
    """Return the `[config: key]` help suffix, escaped for rich.

    Append to an option's `help` string so the configuration key
    that overrides the option's default survives Typer's rich
    markup rendering.
    """
    return f"\\[config: {key}]"
@

Let's verify that the escaped suffix renders back to the literal
text, which is the whole point:

<<test functions>>=
def test_config_hint_survives_rich_markup():
    """The suffix reads literally after rich markup rendering."""
    from rich.text import Text

    hint = config_hint("todo.list.count")
    assert Text.from_markup(hint).plain == "[config: todo.list.count]"
    assert Text.from_markup(
        "Limit N. " + hint
    ).plain == "Limit N. [config: todo.list.count]"
@

