def test_default_reads_config_once():
  fake = MagicMock()
  fake.get.side_effect = KeyError("nope")
  with patch.object(defaults.typerconf, "Config", return_value=fake):
    for _ in range(5):
      default("some.key", 0)
  assert fake.read_config.call_count == 1
