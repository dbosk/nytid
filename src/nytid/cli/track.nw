<<edit command>>=
@cli.command()
def edit(
    entry_hash: Annotated[str, entry_hash_arg],
    at: Annotated[str | None,
                  edit_at_opt] = None,
    end_at: Annotated[str | None,
                      edit_end_at_opt] = None,
    duration: Annotated[str | None,
                       edit_duration_opt] = None,
    label: Annotated[list[str] | None,
                     edit_label_opt] = None,
    add_label: Annotated[list[str] | None,
                         add_label_opt] = None,
    remove_label: Annotated[list[str] | None,
                            remove_label_opt] = None,
    description: Annotated[str | None,
                           edit_description_opt] = None,
    who: Annotated[str | None,
                   edit_who_opt] = None,
):
    """
    Edit one historical tracking entry.

    Use this to fix labels, description, worker, or timestamps after noticing a
    mistake in recorded history.

    \b
    Examples:
      nytid track edit a1b2c3 --description "Weekly planning meeting"
      nytid track edit a1b2c3 --at 14:00 --end-at 15:30
      nytid track edit a1b2c3 -l DD1310 -l grading
      nytid track edit a1b2c3 -a urgent -r draft
    """
    <<reject mixing absolute and relative label edits>>
    label_warnings = []
    def update_history(entries):
        if not entries:
            raise ValueError("No tracking data available")

        original = resolve_tracking_entry(entries, entry_hash)
        start_time = parse_edit_tracking_start_time(at, original)
        duration_hours = (
            parse_hours(duration)
            if duration else None
        )
        end_time = parse_edit_tracking_end_time(
            end_at,
            duration_hours,
            start_time,
            original,
        )
        if end_time <= start_time:
            raise ValueError("End time must be after start time")

        <<compute edited labels>>
        updated = TrackingEntry(
            start_time=start_time,
            end_time=end_time,
            labels=new_labels,
            description=(
                description if description is not None
                else original.description
            ),
            who=(who if who is not None else original.who),
        )
        updated_entries = replace_tracking_entry(entries, original, updated)
        return updated_entries, original, updated

    try:
        _, original, updated = mutate_tracking_history(update_history)
    except ValueError as exc:
        typer.echo(f"Error: {exc}", err=True)
        raise typer.Exit(1)

    for warning in label_warnings:
        typer.echo(f"Warning: {warning}", err=True)
    typer.echo(
        f"Updated {original.content_hash()[:TRACKING_HASH_PREFIX_MIN_LENGTH]} -> "
        f"{updated.content_hash()[:TRACKING_HASH_PREFIX_MIN_LENGTH]}"
    )
@

All three label flags are known before we touch history, so we reject the
contradictory absolute-plus-relative combination at the very top --- there
is no point loading and mutating history only to discover the request was
malformed:

<<reject mixing absolute and relative label edits>>=
if label is not None and (add_label or remove_label):
    typer.echo(
        "Error: --label cannot be combined with "
        "--add-label/--remove-label",
        err=True,
    )
    raise typer.Exit(1)
@

Inside [[update_history]] we know the entry's [[original.labels]], so this
is where the relative merge happens.  [[apply_label_edits]] may raise
[[ValueError]] for the same-label-in-both case; that propagates out of
[[mutate_tracking_history]] and is caught by the existing error handler
below, giving a non-zero exit.  No-op warnings are stashed in the
[[label_warnings]] list declared in the enclosing scope (via [[nonlocal]])
and echoed only after the update succeeds, so a failed edit prints no
misleading warnings.  [[apply_label_edits]] returns labels in insertion
order (the surviving labels in their original order, with additions
appended), not sorted; [[TrackingEntry]] then re-sorts and de-duplicates on
construction, so the stored order is alphabetical regardless of the merge:

<<compute edited labels>>=
nonlocal label_warnings
if label is not None:
    new_labels = list(label)
elif add_label or remove_label:
    new_labels, label_warnings = apply_label_edits(
        original.labels, add_label or [], remove_label or [],
    )
else:
    new_labels = original.labels
@

<<argument and option definitions>>=
force_opt = typer.Option(
    "--force", "-f",
    help="Skip confirmation")
@

<<remove command>>=
@cli.command(name="rm")
def rm(
    entry_hash: Annotated[str, entry_hash_arg],
    force: Annotated[bool, force_opt] = False,
):
    """
    Remove one historical tracking entry.

    Use this when a session was recorded by mistake and should disappear rather
    than be repaired in place.

    \b
    Examples:
      nytid track rm a1b2c3
      nytid track rm a1b2c3 --force
    """
    entries = load_tracking_data()
    if not entries:
        typer.echo("No tracking data available.", err=True)
        raise typer.Exit(1)

    try:
        target = resolve_tracking_entry(entries, entry_hash)
    except ValueError as exc:
        typer.echo(f"Error: {exc}", err=True)
        raise typer.Exit(1)

    if not force and not typer.confirm(
        f"Remove tracking entry {target.content_hash()[:TRACKING_HASH_PREFIX_MIN_LENGTH]}?"
    ):
        typer.echo("Cancelled.")
        raise typer.Exit(0)

    def update_history(current_entries):
        current_target = resolve_tracking_entry(
            current_entries,
            target.content_hash(),
        )
        updated_entries = remove_tracking_entry(current_entries, current_target)
        return updated_entries, current_target

    try:
        _, removed = mutate_tracking_history(update_history)
    except ValueError as exc:
        typer.echo(f"Error: {exc}", err=True)
        raise typer.Exit(1)

    typer.echo(
        f"Removed {removed.content_hash()[:TRACKING_HASH_PREFIX_MIN_LENGTH]}: "
        f"{get_labels_display(removed.labels)}"
    )
@

