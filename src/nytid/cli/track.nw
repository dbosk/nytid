def test_today_groups_matching_label_sets(temp_tracking_dir):
    """Repeated sessions with the same labels collapse together."""
    today = datetime.datetime.now().date().isoformat()
    runner.invoke(cli, [
        "add", "nytid", "devel", "work",
        "--duration", "30m",
        "--at", f"{today} 09:00"
    ])
    runner.invoke(cli, [
        "add", "work", "nytid", "devel",
        "--duration", "45m",
        "--at", f"{today} 11:00"
    ])

    result = runner.invoke(cli, ["today"])
