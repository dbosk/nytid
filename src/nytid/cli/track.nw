    result = runner.invoke(cli, ["adopt"] + args)
  return result, sync_mock, cleanup_mock

def test_adopt_outside_tmux_fails(temp_tracking_dir):
  """Without a tmux context, adopt explains and fails."""
  with patch.dict(os.environ, {}, clear=True):
    result = runner.invoke(cli, ["adopt", "devel"])
  assert result.exit_code == 1

def test_adopt_marks_window_tracked(temp_tracking_dir):
  """Adopt publishes window labels and starts them."""
  result, sync_mock, cleanup_mock = invoke_adopt(
    ["devel", "--who", "me", "--auto-suspend"],
  )

  assert result.exit_code == 0
  assert "Started tracking: devel" in result.stdout
  assert read_window_labels(
    "@7", "me", TEST_SERVER_KEY,
