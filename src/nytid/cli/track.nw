\paragraph{Cleaning.}
Explicit removal keeps the old classification by key token, but
adds the guard the old design lacked: a label-bearing file naming a
window or pane the live server still lists is never removed, no
matter what its key claims, and when the server cannot be listed
nothing is removed at all.  In the persistent tracking directory
the guard is unnecessary---no current code addresses files there,
migration has already rescued the live ones, so files matching this
server's socket are plain leftovers.  Transient kinds (the
last-window pointer, debug logs) carry no labels worth protecting.

<<helper functions>>=
def _sweep_state_files(
    should_remove,
    dry_run: bool,
) -> list[pathlib.Path]:
    removed = []
    for state_dir in _tmux_state_dirs():
        for prefix in TMUX_STATE_FILE_PREFIXES:
            for path in state_dir.glob(prefix + "*"):
                token = parse_state_file_server_key(path.name)
                if token is None or not should_remove(path, token):
                    continue
                removed.append(path)
                if not dry_run:
                    try:
                        path.unlink()
                    except OSError:
                        pass
    return removed

def sweep_stale_server_state(
    current_server_key: str,
    dry_run: bool = False,
) -> list[pathlib.Path]:
    """Remove this socket's unaddressable tmux state files.

    Never removes a label-bearing file naming a window or pane the
    live server still has, and removes nothing at all when the
    server cannot be listed.  Files keyed to other sockets are
    kept.  Returns the affected paths; with ``dry_run`` nothing is
    removed, but the same paths are returned.
    """
    listed = list_live_tmux_ids()
    if listed is None:
        return []
    live_ids = listed[0] | listed[1]
    sockethash = current_server_key.split("-", 1)[0]
    runtime_dir = get_tmux_state_dir()

    def should_remove(path, token):
        stale_socket = token != current_server_key and (
            token.startswith(sockethash)
            or token in LEGACY_STATE_KEY_TOKENS
        )
        if path.parent != runtime_dir:
            return stale_socket or token == current_server_key
        if not stale_socket:
            return False
        if not path.name.startswith(
            MIGRATABLE_STATE_FILE_PREFIXES
        ):
            return True
        return (
            parse_state_file_tmux_id(path.name)
            not in live_ids
        )

    return _sweep_state_files(should_remove, dry_run)
