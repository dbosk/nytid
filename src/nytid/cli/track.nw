        start_time = datetime.datetime.now()
    resolved_who = (
        who if who is not None
        else default_username
    )
    started_labels = []
    already_tracking = []
    resumed_groups = []

    def update(session, history_entries):
        <<restart each stopped group as its own batch>>
        return session, history_entries

    def sync_tmux_context(session, history_entries):
        <<register resumed groups into their windows>>

    mutate_worker_tracking_state(
        update, who,
        post_update=sync_tmux_context,
    )
    return started_labels, already_tracking, []
