def test_hook_install_replaces_stale_key():
    """A superseded switch hook is unset before the append."""
    old_line = (
        "session-window-changed[3] run-shell -b "
        "'nytid track _window-switch-detached "
        "--server-key oldkey --session-id $1'"
    )
    new_cmd = (
        "run-shell -b 'nytid track _window-switch-detached "
        "--server-key newkey --session-id $1'"
    )
    show = subprocess.CompletedProcess(
        args=[], returncode=0, stdout=old_line + "\n", stderr="",
    )
    with patch(
        "nytid.cli.track.subprocess.run",
        side_effect=[show, None, None],
