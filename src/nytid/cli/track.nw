def test_today_uses_calendar_day_window(temp_tracking_dir):
    """Today includes only today's calendar day."""
    today = datetime.datetime.now().date()
    yesterday = today - datetime.timedelta(days=1)
    runner.invoke(cli, [
        "add", "overnight",
        "--duration", "1.5",
        "--at", f"{yesterday.isoformat()} 23:30"
    ])
    runner.invoke(cli, [
        "add", "today",
        "--duration", "1",
        "--at", f"{today.isoformat()} 10:00"
    ])

    result = runner.invoke(cli, ["today"])

    assert result.exit_code == 0
    assert today.isoformat() in result.stdout
    assert yesterday.isoformat() not in result.stdout
    assert "\t2h 0m 0s\t" in result.stdout
    assert "overnight" in result.stdout
    assert result.stdout.count("1h 0m 0s") == 2

