        groups = {}
        stopped = []
        for label in labels:
            if label in self.active_labels:
                start_time, notes, batch_id = (
                    self.active_labels.pop(label)
                )
                self.label_order.remove(label)
                stopped.append(label)
                key = (start_time, batch_id)
                if key not in groups:
                    groups[key] = (
                        start_time, [], notes
                    )
                groups[key][1].append(label)

        if stopped:
            self.last_stopped = [
                {
                    "labels": list(grp_labels),
                    "batch": key[1],
                    "window": None,
                    "server_key": None,
                }
                for key, (st, grp_labels, notes)
                in groups.items()
            ]

        entries = []
        for key, (st, grp_labels, notes) in (
            groups.items()
        ):
            entry = TrackingEntry(
                st, end_time, grp_labels, notes,
                who=who,
            )
            entries.append(entry)

        return entries
