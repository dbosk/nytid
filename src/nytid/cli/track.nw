  monkeypatch.setattr(
    "nytid.cli.track.get_work_days",
    lambda: ["mon", "tue", "wed", "thu", "fri"],
  )
  runner.invoke(cli, [
    "add", "DD1310", "--duration", "8", "--at", "2024-02-12 09:00"
  ])
  runner.invoke(cli, [
    "add", "DD1310", "--duration", "2", "--at", "2024-02-13 09:00"
  ])
  week = [Period(
    datetime.date(2024, 2, 12), datetime.date(2024, 2, 18), "2024-W07"
  )]

  with patch(
    "nytid.cli.track.make_period_ranges", return_value=week
  ):
    result = runner.invoke(cli, ["stats", "weekly", "--no-summary"])

  assert result.exit_code == 0
  assert result.stdout == (
    "2024-W07\t10h 0m\t40h 0m\t-30h 0m\t2/5\t2h 0m\n"
  )

def test_stats_labels_show_share_of_all_tracked(
    temp_tracking_dir, monkeypatch
):
