def test_discard_labels(temp_tracking_dir):
    """Discarding removes labels silently; no history entry is created."""
    session = ActiveSession()
    t0 = datetime.datetime.now()
    session.start_labels(["labelA", "labelB"], t0)

    discarded = session.discard_labels(["labelA"])
    assert discarded == ["labelA"]
    assert "labelA" not in session.active_labels
    assert "labelB" in session.active_labels

    # Discarding a non-active label is a no-op
    discarded = session.discard_labels(["labelA"])
    assert discarded == []

