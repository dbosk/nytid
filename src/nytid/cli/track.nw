def test_edit_batch_swaps_sibling():
  """Kept labels keep notes and start when a sibling is swapped."""
  session = ActiveSession()
  t0 = datetime.datetime(2026, 3, 12, 10, 0)
  session.start_labels(["keep", "wrong"], t0)
