    Renames files provably belonging to the current tmux server,
    but filed under an outdated key or in the persistent tracking
    directory, so the current code finds them again.  Only files
    naming a window or pane the live server still has are moved;
    nothing is ever deleted.  Returns (source, target) pairs.
    """
    sockethash = current_server_key.split("-", 1)[0]
    start_time = current_server_key.rsplit("-", 1)[-1]
    runtime_dir = get_tmux_state_dir()
    moved = []
    live_ids: set[str] | None = None
    for state_dir in _tmux_state_dirs():
        for prefix in MIGRATABLE_STATE_FILE_PREFIXES:
            for path in state_dir.glob(prefix + "*"):
                token = parse_state_file_server_key(path.name)
                <<skip files not provably this server's>>
                <<skip live-server check when tmux is unlistable>>
                <<move the file under the current key>>
    return moved
