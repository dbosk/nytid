The calendar is pinned by patching [[make_period_ranges]], the idiom
the module uses instead of faking the clock, and the dates are in a
past February so that the expectation is not clipped to today.  Every
day is a work day unless the test says otherwise.

<<test functions>>=
def february_days():
  """Wednesday 14 back to Monday 12 February 2024, newest first."""
  return [
    Period(datetime.date(2024, 2, day), datetime.date(2024, 2, day),
           f"2024-02-{day}")
    for day in (14, 13, 12)
  ]

def test_stats_daily_shows_empty_periods_as_zero(
    temp_tracking_dir, monkeypatch
):
  """Every requested period is a row, worked or not."""
  monkeypatch.setattr(
    "nytid.cli.track.get_work_days", lambda: DAY_NAMES
  )
  runner.invoke(cli, [
    "add", "DD1310", "--duration", "1", "--at", "2024-02-13 10:00"
  ])

  with patch(
    "nytid.cli.track.make_period_ranges",
    return_value=february_days(),
  ):
    result = runner.invoke(cli, ["stats", "daily", "--no-summary"])

  assert result.exit_code == 0
  assert result.stdout == (
    "2024-02-14\t0m\t8h 0m\t-8h 0m\n"
    "2024-02-13\t1h 0m\t8h 0m\t-7h 0m\n"
    "2024-02-12\t0m\t8h 0m\t-8h 0m\n"
  )

