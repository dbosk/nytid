def test_start_replace_backdates_active_label(temp_tracking_dir):
    """--replace discards the current session and restarts with the new time."""
    # Start normally, then immediately replace with a backdated start.
    runner.invoke(cli, ["start", "labelA"])
    result = runner.invoke(cli, [
        "start", "labelA", "--offset", "-60m", "--replace"
    ])
    assert result.exit_code == 0
    assert "Replaced: labelA" in result.stdout
    assert "Started tracking: labelA" in result.stdout

    # The session file should record a start time ~60 min ago, not ~0 min ago.
    session = load_active_session(default_username)
    start_time, _, _ = session.get_label_info("labelA")
    delta = datetime.datetime.now() - start_time
    assert delta.total_seconds() > 50 * 60, (
        "Start time should be roughly 60 minutes in the past"
    )

def test_start_replace_does_not_affect_other_labels(temp_tracking_dir):
    """--replace only touches the named labels; siblings are untouched."""
    runner.invoke(cli, ["start", "labelA", "labelB"])
    result = runner.invoke(cli, [
        "start", "labelA", "--offset", "-30m", "--replace"
    ])
    assert result.exit_code == 0
    assert "Replaced: labelA" in result.stdout

    session = load_active_session(default_username)
    # labelB must still be active with its original (recent) start time.
    assert session.get_label_info("labelB") is not None
    b_start, _, _ = session.get_label_info("labelB")
