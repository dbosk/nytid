    runner.invoke(cli, ["start", "global"])
  env = {
    "TMUX_PANE": "%99",
    "TMUX": "/tmp/tmux.sock,123,0",
  }
  with patch.dict(os.environ, env), patch(
    "nytid.cli.track.get_tmux_window_id_for_pane",
    return_value=window_id,
  ):
    runner.invoke(cli, ["start", "windowed"])
    result = runner.invoke(
      cli,
      ["edit", "--containing", "global",
       "-a", "extra"],
    )
  assert result.exit_code == 0
  session = load_active_session(default_username)
  assert (
    session.active_labels["extra"][2]
    == session.active_labels["global"][2]
  )

def test_bare_switch_scoped_to_tracked_window(
  temp_tracking_dir,
):
  """switch in a tracked window suspends only its batch."""
  window_id = "@42"
  write_window_labels(
    window_id, default_username, TEST_SERVER_KEY, [],
  )
  env = {
    "TMUX_PANE": "%99",
    "TMUX": "/tmp/tmux.sock,123,0",
  }
  with patch.dict(os.environ, env), patch(
    "nytid.cli.track.get_tmux_window_id_for_pane",
    return_value=window_id,
  ):
    runner.invoke(cli, ["start", "windowed"])
  with patch.dict(os.environ, {}, clear=True):
    runner.invoke(cli, ["start", "global"])
  with patch.dict(os.environ, env), patch(
    "nytid.cli.track.get_tmux_window_id_for_pane",
    return_value=window_id,
  ):
    result = runner.invoke(
      cli, ["switch", "meeting"],
    )
  assert result.exit_code == 0
  session = load_active_session(default_username)
  assert "global" in session.active_labels
  assert "meeting" in session.active_labels
  assert "windowed" not in session.active_labels
