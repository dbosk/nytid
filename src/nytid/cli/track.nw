With the idempotent installer in hand, we only need the authoritative
[[session-window-changed]] hook for window tracking.  The hook remains
session-scoped so multiple tracked windows in the same session share the
same selected-window transition stream.

A window-switch hook line is superseded when it drives the same
entry point for the same worker in this session---then the current
command is its replacement, whatever key or nytid path the old line
baked in.  The worker check matters because two workers sharing one
tmux session each own a hook: [[build_detached_window_switch_command]]
only emits [[--who]] for non-default workers, so the default worker's
lines are exactly those without a [[--who]].

<<helper functions>>=
def window_switch_hook_is_stale(
    line: str,
    who: str,
) -> bool:
    """Return whether a hook line is a superseded switch hook."""
    if "_window-switch-detached" not in line:
        return False
    if who == default_username:
        return "--who" not in line
    return f"--who {shlex.quote(who)}" in line

def install_tmux_window_sync_hooks(
    session_id: str,
    who: str,
    tmux_server_key: str,
) -> None:
    """Install the authoritative tmux hook for window tracking."""
    switch_cmd = build_detached_window_switch_command(
        who, tmux_server_key, session_id,
    )
    switch_hook = f"run-shell -b {shlex.quote(switch_cmd)}"
    install_tmux_hook_once(
        session_id,
        "session-window-changed",
        switch_hook,
        is_stale=lambda line: window_switch_hook_is_stale(
            line, who,
        ),
    )
