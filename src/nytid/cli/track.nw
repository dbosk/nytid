  subprocess.run(
    ["git", "-C", repo, "worktree", "remove", wt], check=True,
  )
  assert not os.path.isdir(wt)
  wt2 = ensure_worktree(repo, "feat")
  assert wt2 == wt and os.path.isdir(wt2)
  branches = subprocess.run(
    ["git", "-C", repo, "branch", "--list", "worktree-feat"],
    capture_output=True, text=True, check=True,
