The [[--no-id]] fast path is easy to lose to a refactor that hoists
the prefix computation back out of the [[if]], so we pin it by
counting [[content_hash()]] calls through a wrapping monkeypatch:
a listing without the id column must compute no digests at all.

<<test functions>>=
def test_ls_without_id_never_hashes(temp_tracking_dir, monkeypatch):
    """A --no-id listing computes no content hashes at all."""
    for hour in range(5):
        runner.invoke(cli, [
            "add", "DD1310",
            "--duration", "30m",
            "--at", f"2026-03-12 {8 + hour:02d}:00"
        ])

    calls = []
    original_hash = TrackingEntry.content_hash

    def counting_hash(self):
        calls.append(self)
        return original_hash(self)

    monkeypatch.setattr(
        TrackingEntry, "content_hash", counting_hash
    )

    result = runner.invoke(cli, ["ls", "--no-id"])

    assert result.exit_code == 0
    assert calls == []

