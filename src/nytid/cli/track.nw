def test_debug_config_writes_stay_in_the_sandbox(
    preserve_config, real_config_fingerprint,
):
    """typerconf writes land in the sandbox, not the real config."""
    import typerconf as config

    before = real_config_fingerprint()

    config.set(TRACK_DEBUG_CONFIG, "1")

    assert config.get(TRACK_DEBUG_CONFIG) == "1"
    assert real_config_fingerprint() == before
    assert json.loads(
        preserve_config.read_text()
    )["track"]["debug"] == "1"
