    "--duration", "1",
    "--at", "2026-03-12 10:00"
  ])
  original = load_tracking_data()[0]

  result = runner.invoke(cli, [
    "edit", original.content_hash()[:8], "-a", "nytid"
  ])

  assert result.exit_code == 0
  assert "already present" in result.output
  assert load_tracking_data()[0].labels == ["nytid"]

@

