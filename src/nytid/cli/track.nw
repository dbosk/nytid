<<helper functions>>=
def sweep_all_server_state(
    dry_run: bool = False,
) -> list[pathlib.Path]:
    """Remove all tmux state files, regardless of server.

    Returns the affected paths; with ``dry_run`` nothing is
    removed, but the same paths are returned.
    """
    return _sweep_state_files(
        lambda path, token: True, dry_run,
    )
@

The user-facing command first migrates, then removes: repairing a
misfiled live file both rescues it and clears the way for the
removal pass to classify what remains.  The default scope is the
current server's socket, guarded by the live listing; anything
wider needs the user's [[--all]] assertion.  Since deletion is
irreversible, [[--dry-run]] lets the user inspect the verdict
first using the very same classification.  We bypass
[[get_current_tmux_server_key]] here on purpose: its no-state glob
guard returns [[None]] when the runtime directory holds no
current-format files, which would make the command refuse to run
right when only misfiled or legacy files are left to handle.

<<argument and option definitions>>=
clean_dry_run_opt = typer.Option(
    "--dry-run", "-n",
    help="Only list the files that would be moved or removed")
clean_all_opt = typer.Option(
    "--all",
    help="Remove tmux state for all servers, not only "
         "dead instances of the current one")
@

<<clean command>>=
@cli.command()
def clean(
    dry_run: Annotated[bool, clean_dry_run_opt] = False,
    all_servers: Annotated[bool, clean_all_opt] = False,
):
    """
    Repair and remove stale tmux tracking state files.

    Moves the live server's misfiled state files back into reach,
    then removes files of dead instances of the current server.
    Files naming still-open windows are never removed.  Use --all
    to wipe all servers' state instead.
    """
    moved = []
    if all_servers:
        removed = sweep_all_server_state(dry_run=dry_run)
    else:
        server_key = compute_tmux_server_key(
            os.environ.get("TMUX")
        )
        if server_key is None:
            typer.echo(
                "Not inside a running tmux server; "
                "use --all to remove state for all servers.",
                err=True,
            )
            raise typer.Exit(1)
        moved = migrate_tmux_state_files(
            server_key, dry_run=dry_run,
        )
        removed = sweep_stale_server_state(
            server_key, dry_run=dry_run,
        )
    move_verb = "Would move" if dry_run else "Moved"
    for source, target in moved:
        typer.echo(
            f"{move_verb} {source.name} -> {target.name}"
        )
    verb = "Would remove" if dry_run else "Removed"
    for path in removed:
        typer.echo(f"{verb} {path.name}")
    if not moved and not removed:
        typer.echo("No stale tmux state files found.")
