  """Adopt backfills batch ids for fresh and running labels."""
  runner.invoke(cli, ["start", "already", "--who", "me"])
  result, _, _ = invoke_adopt(
    ["already", "fresh", "--who", "me",
     "--no-auto-suspend"],
