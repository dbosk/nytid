        os.environ, {"TMUX": "/tmp/tmux.sock,7446,0"}, clear=True,
    ), patch(
        "nytid.cli.track.get_tmux_server_generation",
        return_value="7446-1700000000",
    ):
        second = compute_tmux_server_key(os.environ["TMUX"])
    assert first == second

def test_generation_from_live_server():
    """The generation is queried from tmux, not read from $TMUX."""
    completed = subprocess.CompletedProcess(
        args=[], returncode=0,
        stdout="7446-1700000000\n", stderr="",
    )
    with patch.dict(
        os.environ, {"TMUX": "/tmp/tmux.sock,7393,0"}, clear=True,
    ), patch(
        "nytid.cli.track.subprocess.run", return_value=completed,
    ) as run_mock:
        assert get_tmux_server_generation() == "7446-1700000000"
    assert run_mock.call_args.args[0] == [
        "tmux", "display-message", "-p", "#{pid}-#{start_time}",
    ]

