    TodoItem(
      id=1, title="Fix bug", wd=repo, worktree="fix-42",
      created="2026-02-20T10:00:00",
    ),
  ])
  run_only_git.calls = []
  with patch(
    "nytid.cli.todo.subprocess.run", side_effect=run_only_git,
  ):
    result = runner.invoke(
      cli, ["start", "1", "--headless", "--command", "true"],
    )
  assert result.exit_code == 0, result.output
  expected = os.path.join(repo, ".claude", "worktrees", "fix-42")
  assert len(run_only_git.calls) == 1
  assert run_only_git.calls[0][1]["cwd"] == expected
  assert "Removed unchanged worktree" in result.stdout
  assert not os.path.isdir(expected)


