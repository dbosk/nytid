def test_done_completes_abandoned_context_parent(temp_todo_dir):
  """A stale context claim does not block auto-completion."""
  from nytid.cli.track import (
    ActiveSession,
    load_active_session,
    save_active_session,
  )
  from nytid.cli.todo import mutate_todo_state
  save_todos(3, [
    TodoItem(
      id=1, title="Course", labels=["course"],
      created="2026-02-20T10:00:00",
    ),
    TodoItem(
      id=2, title="User's part", parents=[1],
      created="2026-02-20T10:00:00",
    ),
  ])
  save_active_stack([1, 2])

  def leave_stale_claim(next_id, todos, stack):
    todos[0].claimed_by = "dan-claude"
    todos[0].context_claim = True
    todos[1].claimed_by = default_username
    return next_id, todos, stack

  mutate_todo_state(leave_stale_claim)
  session = ActiveSession()
  session.start_labels(
    ["course", "todo:1"],
    datetime.datetime(2026, 2, 20, 10, 0),
  )
  save_active_session(session, "dan-claude")

  result = runner.invoke(cli, ["done"])

  assert result.exit_code == 0, result.output
  assert "auto-completed" in result.output
  _, todos = load_todos()
  assert todos[0].status == "done"
  assert load_active_session(
    "dan-claude"
  ).get_active_labels() == []
