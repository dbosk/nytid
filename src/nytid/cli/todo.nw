Let's verify that the nesting survives wrapping: at a width where a
long grandchild title breaks across lines, every one of its lines is
indented past the lines of its parent's own wrapped title.

<<test functions>>=
def test_view_rich_grandchild_indent_survives_wrapping(
    temp_todo_dir,
):
    """Wrapped grandchild titles stay indented under the parent."""
    long_title = " ".join(["word"] * 30)
    save_todos(4, [
        TodoItem(
            id=1, title="Parent",
            created="2026-02-20T10:00:00",
        ),
        TodoItem(
            id=2, title="child " + long_title, parents=[1],
            created="2026-02-20T10:00:00",
        ),
        TodoItem(
            id=3, title="grandchild " + long_title, parents=[2],
            created="2026-02-20T10:00:00",
        ),
    ])
    result = runner.invoke(
        cli, ["view", "1", "-r", "--format", "rich"],
        terminal_width=60,
    )
    assert result.exit_code == 0
    lines = result.output.splitlines()
    child_start = next(
        i for i, l in enumerate(lines) if "child word" in l
    )
    gc_start = next(
        i for i, l in enumerate(lines) if "grandchild word" in l
    )
    child_lines = lines[child_start + 1:gc_start]
    gc_lines = [l for l in lines[gc_start + 1:] if l.strip()]
    assert len(child_lines) > 1 and len(gc_lines) > 1

    def title_indent(line):
        return len(line) - len(line.lstrip())

    child_indent = min(title_indent(l) for l in child_lines)
    for line in gc_lines:
        assert title_indent(line) > child_indent, line
