Listing issues and PRs returns summaries for bulk import. We
include [[createdAt]] because the age-based priority heuristic
in the [[import]] command needs timestamps to rank items.  We also
include [[closedAt]], although the lists return only open items unless
asked otherwise, so that the import loop sees the same fields whichever
fetch produced an item and reads the closing time in one way
(\cref{sec:todo-github-closed}):

<<helpers>>=
def gh_list_issues(repo):
    """List open issues from a GitHub repository.

    Returns a list of dicts with number, title, body,
    state, labels, createdAt, and closedAt fields.
    """
    result = subprocess.run(
        [
            "gh", "issue", "list",
            "-R", repo,
            "--json",
            "number,title,body,state,"
            "labels,createdAt,closedAt",
            "--limit", "100",
        ],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise RuntimeError(
            f"gh issue list failed: "
            f"{result.stderr.strip()}"
        )
    return json.loads(result.stdout)
@

