(\cref{track:worktrees}), because that is where the name is turned into
a path; here we only translate its [[ValueError]] into the same clean
[[typer.Exit]] that [[canonicalize_wd]] produces, and map [[None]] and
the empty string to [[None]] so that [[--worktree ""]] clears the field.

<<helpers>>=
def normalize_worktree_name(name):
    """Return a validated worktree name, or ``None`` if unset.

    ``None`` and the empty string mean no worktree.  Any other
    value must be a string without path separators; otherwise we
    exit with an error pointing at the offending value.
    """
    if name is None or name == "":
        return None
    if not isinstance(name, str):
        typer.echo(
            f"Error: worktree must be a string, "
            f"got {type(name).__name__}: {name!r}",
            err=True,
        )
        raise typer.Exit(1)
    try:
        return validate_worktree_name(name)
    except ValueError as exc:
        typer.echo(f"Error: {exc}", err=True)
        raise typer.Exit(1)
@

<<test functions>>=
def test_normalize_worktree_name_accepts_plain_name():
    """A plain name passes through unchanged."""
    assert normalize_worktree_name("fix-42") == "fix-42"


def test_normalize_worktree_name_empty_is_none():
    """None and the empty string both mean no worktree."""
    assert normalize_worktree_name(None) is None
    assert normalize_worktree_name("") is None


def test_normalize_worktree_name_rejects_separator():
    """A path separator in the name is a clean error."""
    with pytest.raises(typer.Exit):
        normalize_worktree_name("a/b")


def test_normalize_worktree_name_rejects_non_string():
    """A YAML integer is a clean error, not a TypeError."""
    with pytest.raises(typer.Exit):
        normalize_worktree_name(42)
@

The stored command needs the same treatment, but for a different
reason.  A worktree name is validated because it becomes a path; a
command is never validated here, since the [[track]] module's
[[resolve_command_argv]] parses it at start time.  What the two
share is the question of what \emph{nothing} looks like.  [[None]] is
the only value the runtime fallback recognises: [[TodoItem]] consults
the worker default when the stored value is [[None]]
(\cref{todo:worker-defaults}), so an empty string stored in its place
would silently disable [[todo.worker.<worker>.command]] while showing
up nowhere---the editor buffer omits falsy commands, and [[start]]
skips them.  Mapping a blank to [[None]] is what lets
[[edit --command ""]] and an emptied [[command:]] line in the editor
both mean \enquote{back to the default}.  The [[str]] coercion is for
the front-matter table, whose parser types a bare number
(\cref{sec:apply-metadata}).

<<helpers>>=
def normalize_command(command):
    """Return the command string, or `None` when blank.

    `None` and a blank string both mean no stored command,
    so the worker default applies again at runtime.  Any
    other value is stored as a string.
    """
    if command is None or not str(command).strip():
        return None
    return str(command)
@

<<test functions>>=
def test_normalize_command_blank_is_none():
    """None, the empty string and whitespace all clear."""
    assert normalize_command(None) is None
    assert normalize_command("") is None
    assert normalize_command("   ") is None


def test_normalize_command_keeps_text():
    """A real command passes through unchanged."""
    assert normalize_command("claude -p x") == "claude -p x"


def test_normalize_command_coerces_to_string():
    """A YAML integer becomes a string, as before."""
    assert normalize_command(42) == "42"
@

