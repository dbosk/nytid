    """Whatever the renderer emits, the parser reads back."""
    hostile = [
        "One line.",
        "Two paragraphs.\n\nSecond one: with a colon.",
        "  code first\nthen text",
        "  all\n  indented",
        "42",
        "[not, a, list]",
        "# not a heading\n---\nnot a delimiter",
        "|",
