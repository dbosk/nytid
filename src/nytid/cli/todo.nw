<<print notes as plain text>>=
if item.github:
    if gh_body:
        typer.echo("")
        typer.echo("Description:")
        print_markdown(gh_body, indent=2, terminal=False)
    if gh_comments:
        typer.echo("")
        typer.echo("Comments:")
        for author, created, body in gh_comments:
            typer.echo(f"  [{author} {created}]")
            print_markdown(body, indent=4, terminal=False)
            typer.echo("")
elif item.notes:
