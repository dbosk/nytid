def test_root_is_never_pushed():
  """Pushing the root id is refused, any other id is not."""
  stack = [3]
  push_active(stack, 5)
  push_active(stack, 4, index=1)
  assert stack == [3, 4, 5]
  with pytest.raises(ValueError):
    push_active(stack, ROOT_ID)
