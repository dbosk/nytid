@contextlib.contextmanager
def patched_worker_config(values):
    """Serve `values` from the defaults cache for one test."""
    def config_get(path):
        if path in values:
            return values[path]
        raise KeyError(path)

    fake = MagicMock()
    fake.get.side_effect = config_get
    defaults._reset_cache()
    try:
        with patch.object(
            defaults.typerconf, "Config", lambda: fake
        ):
            yield
    finally:
        defaults._reset_cache()
