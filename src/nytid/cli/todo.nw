<<edit command>>=
@cli.command(cls=PassThroughCommand)
def edit(
    ctx: typer.Context,
    todo_id: Annotated[int | None,
                       todo_id_arg] = None,
    edit_interactive: Annotated[bool,
                                editor_opt] = False,
    title: Annotated[str | None,
                     title_opt] = None,
    deadline: Annotated[str | None,
                        deadline_opt] = None,
    estimate: Annotated[str | None,
                        estimate_opt] = None,
    label: Annotated[list[str] | None,
                     edit_label_opt] = None,
    add_label: Annotated[list[str] | None,
                         add_label_opt] = None,
    remove_label: Annotated[list[str] | None,
                            remove_label_opt] = None,
    description: Annotated[str | None,
                           description_opt] = None,
    who: Annotated[str | None,
                   edit_who_opt] = None,
    wd_path: Annotated[str | None,
                       wd_opt] = None,
    worktree: Annotated[str | None,
                        worktree_opt] = None,
    capture_env: Annotated[bool, env_opt] = False,
    here: Annotated[bool, here_opt] = False,
    run_command: Annotated[str | None,
                           command_opt] = None,
    parent: Annotated[int | None,
                      edit_parent_opt] = None,
    add_parent: Annotated[list[int] | None,
                          add_parent_opt] = None,
    remove_parent: Annotated[list[int] | None,
                             remove_parent_opt] = None,
    explicit_priority: Annotated[float | None,
                                 prio_opt] = None,
    top: Annotated[bool, top_opt] = False,
    bottom: Annotated[bool, bottom_opt] = False,
    keep_prio: Annotated[bool, keep_prio_opt] = False,
    discovered_from: Annotated[int | None,
                               edit_discovered_from_opt] = None,
):
    """Edit an existing todo item.

    If no ID given, edits the current active task.

    The canonical command override form is
    ``nytid todo edit 7 -- prog args``.

    An empty ``--command ""`` clears the stored command.
    """
    clear_command = (
        run_command is not None and not run_command.strip()
    )
    if clear_command:
        run_command = None
    try:
        _, run_command = resolve_command_argv(run_command, ctx)
    except ValueError as exc:
        typer.echo(f"Error parsing command: {exc}", err=True)
        raise typer.Exit(1)
    except typer.BadParameter as exc:
        typer.echo(f"Error: {exc}", err=True)
        raise typer.Exit(1)
    _, todos = load_todos()
    todo_id = resolve_todo_id(
        todo_id, "edit",
        who=default_username, todos=todos,
    )
    item = next(
        (t for t in todos if t.id == todo_id), None
    )
    if item is None:
        typer.echo(
            f"Error: todo #{todo_id} not found",
            err=True,
        )
        raise typer.Exit(1)
    before = item_fields(item)

    if edit_interactive:
        <<edit via editor>>
    else:
        <<edit via cli flags>>
@

Four of the flags say where the item should rank, and the shared
validator (\cref{todo:placement}) rejects any two of them together.  It
runs first, before a single field is touched, so a contradictory
command line cannot half-apply.

<<edit via cli flags>>=
reject_conflicting_flags({
    "--keep-prio": keep_prio,
    "--prio": explicit_priority is not None,
    "--top": top,
    "--bottom": bottom,
})
@

The remaining flags are optional and default to [[None]]. We only
overwrite a field when the user explicitly supplied a value ---
[[None]] means \enquote{leave this field alone}. This lets you update a
single attribute (e.g.\ just the deadline) without touching the rest of
the item:

<<edit via cli flags>>=
if title is not None:
    item.title = title
if deadline is not None:
    item.deadline = normalize_deadline(deadline)
if estimate is not None:
    item.estimated = parse_hours(estimate)
<<apply label edits>>
