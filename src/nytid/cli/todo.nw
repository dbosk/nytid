peek_item = next(
    (t for t in peek_todos if t.id == peek_id), None,
)
<<resolve worktree for todo start>>=
worktree_dir = None
worktree_launch = None
worktree_name = worktree or (
    peek_item.worktree if peek_item else None
)
if worktree_name:
    base_dir = (
