    with patch(
        "nytid.cli.todo.open_editor", return_value="New\n",
    ):
        result = runner.invoke(cli, args)

    assert result.exit_code == 0, result.output
    assert stored_priority(3) == 4.75
    assert stored_priority(4) == 4.25
