        TodoItem(id=2, title="B", created="2026-02-20T10:00:00"),
        TodoItem(
            id=3, title="Shared", parents=[ROOT_ID, 1, 2],
            created="2026-02-20T10:00:00",
        ),
    ])
    result = runner.invoke(cli, ["export", "--format", "vtodo"])
    assert result.exit_code == 0, result.output
    lines = result.stdout.splitlines()
    assert "UID:todo-3@nytid" in lines
    assert [
        line for line in lines if line.startswith("RELATED-TO")
    ] == [
        "RELATED-TO;RELTYPE=PARENT:todo-1@nytid",
        "RELATED-TO;RELTYPE=PARENT:todo-2@nytid",
    ]


