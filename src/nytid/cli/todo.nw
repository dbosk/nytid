must fail and leave the first move standing.

<<test functions>>=
def test_overlapping_moves_cannot_make_a_cycle(temp_todo_dir):
    """Two moves from one snapshot cannot make a cycle."""
    from nytid.cli.todo import edit
    save_todos(3, [
        TodoItem(
            id=1, title="A", created="2026-02-20T10:00:00",
        ),
        TodoItem(
            id=2, title="B", created="2026-02-20T10:00:00",
        ),
