Three children with three grandchildren each, under [[-n 2]], is the
case that separates a per-parent cap from a cap on the flat row list:
a row cap of two would stop inside the first child's grandchildren
and never reach a second child.  The count it has to report adds up
from three different sources---the grandchildren each shown child
lost, plus the cut child together with everything under it---so
getting it right is evidence that all three are accounted for.

<<integration tests>>=
def test_view_n_caps_children_and_grandchildren(temp_todo_dir):
    """-n bounds each level, and the hint counts every branch."""
    children = [
        TodoItem(
            id=n, title=f"Child {letter}", parents=[1],
            priority=float(4 - n),
            created="2026-02-20T10:00:00",
        )
        for n, letter in ((2, "A"), (3, "B"), (4, "C"))
    ]
    grandchildren = [
        TodoItem(
            id=5 + 3 * offset + index,
            title=f"GC {letter}{index + 1}",
            parents=[parent],
            priority=float(3 - index),
            created="2026-02-20T10:00:00",
        )
        for offset, (parent, letter) in enumerate(
            ((2, "A"), (3, "B"), (4, "C"))
        )
        for index in range(3)
    ]
    save_todos(14, [
        TodoItem(
            id=1, title="Parent task",
            created="2026-02-20T10:00:00",
        ),
    ] + children + grandchildren)

    result = runner.invoke(cli, ["view", "1", "-r", "-n", "2"])

    assert result.exit_code == 0
    out = result.stdout
    assert "Child A" in out and "Child B" in out
    assert "Child C" not in out
    assert "GC A1" in out and "GC A2" in out
    assert "GC A3" not in out
    assert "GC B1" in out and "GC B2" in out
    assert "GC B3" not in out
    assert "GC C1" not in out
    assert "6 more sub-items hidden" in out
