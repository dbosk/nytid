TEST_GIT_CONFIG = [
  "-c", "user.name=Test",
  "-c", "user.email=t@example.com",
  "-c", "commit.gpgsign=false",
]
REAL_SUBPROCESS_RUN = subprocess.run


def make_git_repo(path):
  """Initialise a git repository with one commit at `path`."""
  path = str(path)
  os.makedirs(path, exist_ok=True)
  subprocess.run(["git", "init", "-q", path], check=True)
  git = ["git", "-C", path] + TEST_GIT_CONFIG
  with open(os.path.join(path, "README"), "w") as f:
    f.write("hello\n")
  subprocess.run(git + ["add", "README"], check=True)
  subprocess.run(git + ["commit", "-q", "-m", "init"], check=True)
  return path


def run_only_git(*args, **kwargs):
  """Forward git subprocesses; mock everything else."""
  if args and args[0] and args[0][0] == "git":
    return REAL_SUBPROCESS_RUN(*args, **kwargs)
  fake = MagicMock()
  fake.returncode = 0
  fake.stdout = ""
  run_only_git.calls.append((args, kwargs))
  return fake


def test_start_uses_stored_worktree(temp_todo_dir, tmp_path):
  """A stored worktree is created off wd and the command runs there."""
  repo = make_git_repo(tmp_path / "repo")
