<<test functions>>=
def test_view_shows_where_an_item_came_from(temp_todo_dir):
  """view names the source and, on the source, what it led to."""
  save_todos(5, [
    TodoItem(
      id=1, title="Fix the parser",
      created="2026-02-20T10:00:00",
    ),
    TodoItem(
      id=2, title="Lexer bug",
      created="2026-02-20T10:00:00", discovered_from=1,
    ),
    TodoItem(
      id=3, title="Missing test",
      created="2026-02-20T10:00:00", discovered_from=1,
    ),
    TodoItem(
      id=4, title="Orphaned find",
      created="2026-02-20T10:00:00", discovered_from=9,
    ),
  ])

  found = runner.invoke(cli, ["view", "2", "--format", "plain"])
  assert found.exit_code == 0, found.output
  assert "  Discovered from: #1 Fix the parser\n" in found.output
  assert "Led to" not in found.output

  source = runner.invoke(cli, ["view", "1", "--format", "plain"])
