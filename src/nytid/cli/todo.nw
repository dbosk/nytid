An added place can only raise the number, so the item is ranked there
starting from the number it has.

<<rank the item in each added place>>=
by_id = {t.id: t for t in todos}
if keep_prio:
    for place in added_places:
        parent_ctx = by_id.get(place)
        if parent_ctx is None or parent_ctx.priority is None:
            continue
        <<refuse a kept number below an added place>>
elif explicit_priority is not None:
    item.priority = explicit_priority
else:
    item.priority = place_in_places(
        todos, item, added_places, placement, item.priority,
