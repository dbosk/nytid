def test_ready_filters_like_ls(temp_todo_dir):
  """Labels and --who select from the ready items what ls selects."""
  save_ready_fixture()
  ready_set = set(ready_ids("--who", ""))
  for args in (
    ["grading"],
    ["course", "research"],
    ["nosuchlabel"],
    ["--who", "dan"],
    ["--who", "^me$", "grading"],
