The description is applied at five sites (parent and children, in
[[edit]] and in [[add]]), which is exactly the kind of duplication
that drifts.  A fixed-point test guards all of them at once: an item
whose description contains everything the format could trip on---a
[[---]] line, a column-0 heading, an indented line, a colon---goes
through an unchanged editor buffer and must come back byte for byte,
along with every other field, and must render identically again.

<<test functions>>=
def test_edit_editor_description_fixed_point(temp_todo_dir):
    """A hostile description survives an unchanged buffer."""
    hostile = (
        "Standing statement.\n\n"
        "---\n"
        "# Not a heading\n"
        "    indented code\n"
        "Colon: in text.\n"
    )
    original = TodoItem(
        id=1, title="Parent",
        description=hostile, notes="Running log.",
        labels=["DD1310"],
        deadline=normalize_deadline("2026-03-01"),
        estimated=1.5, who="dbosk",
        wd=canonicalize_wd("/tmp/project"),
        worktree=normalize_worktree_name("fix-42"),
        command="claude",
        created="2026-02-20T10:00:00",
    )
    child = TodoItem(
        id=2, title="Child", parents=[1], priority=1.0,
        description="  starts indented\nthen not",
        notes="Child log.",
        created="2026-02-20T10:00:00",
    )
    save_todos(3, [original, child])
    first_render = render_todo_markdown(
        original, [original, child]
    )

    with patch(
        "nytid.cli.todo.open_editor",
        side_effect=lambda text: text,
    ):
        result = runner.invoke(cli, ["edit", "1", "--edit"])
    assert result.exit_code == 0, result.output

    _, todos = load_todos()
    reloaded = {t.id: t for t in todos}
    assert reloaded[1].description == hostile.rstrip("\n")
    for field_name in (
        "title", "notes", "labels", "deadline", "estimated",
        "who", "wd", "worktree", "command",
    ):
        assert getattr(reloaded[1], field_name) == getattr(
            original, field_name
        ), field_name
    assert reloaded[2].description == child.description
    assert reloaded[2].notes == "Child log."
    assert render_todo_markdown(
        reloaded[1], todos
    ) == first_render
