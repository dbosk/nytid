def ranking_is_consistent(todos: list[TodoItem]) -> bool:
    """Tell whether the ranked, not-done items nest.

    Each lies inside its ranking context's child range and
    above the floor of its other ranked parents, and the
    items ranked under each follow it directly in the flat
    order.
    """
    index = RankingIndex(todos)
    by_id, contexts = index.by_id, index.contexts
    live = [t for t in todos if index.laid_out(t)]
    <<check that each item sits inside its places>>
    <<check that each ranked subtree follows its root>>
    return True
