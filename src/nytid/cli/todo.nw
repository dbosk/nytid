Notes read from standard input usually end in a newline, which the
saved buffer drops.  That alone must not count as an edit when a note
landed meanwhile, while an untouched save with nothing landing still
tidies the newline away as it always has:

<<test functions>>=
@pytest.mark.parametrize(
    "meanwhile,expected",
    [
        (True, "First\n\nAgent"),
        (False, "First"),
    ],
)
def test_note_edit_untouched_buffer_with_trailing_newline(
    temp_todo_dir, meanwhile, expected,
):
    """A dropped trailing newline is not an edit."""
    from nytid.cli.todo import note
    save_todos(2, [
        TodoItem(
            id=1, title="Local task",
            created="2026-02-20T10:00:00",
            notes="First\n",
        ),
    ])

    def untouched_editor(initial=""):
        if meanwhile:
            note(1, message="Agent", edit=False)
        return initial

    with patch(
        "nytid.cli.todo.open_editor",
        side_effect=untouched_editor,
    ):
        result = runner.invoke(cli, ["note", "1", "--edit"])
    assert result.exit_code == 0, result.stdout
    _, todos = load_todos()
    assert without_note_headers(todos[0].notes) == expected
