<<test functions>>=
def test_view_shows_closed_time(temp_todo_dir):
  """A done item shows when it was closed, to the minute."""
  save_todos(3, [
    TodoItem(
      id=1, title="Finished",
      created="2026-02-20T10:00:00",
      status="done",
      closed="2026-10-08T14:03:59.123456",
    ),
    TodoItem(
      id=2, title="Open",
      created="2026-02-20T10:00:00",
    ),
  ])

  done = runner.invoke(cli, ["view", "1", "--format", "plain"])
  assert done.exit_code == 0, done.output
  assert "  Closed: 2026-10-08 14:03\n" in done.output

  still_open = runner.invoke(
    cli, ["view", "2", "--format", "plain"]
  )
  assert still_open.exit_code == 0, still_open.output
  assert "Closed" not in still_open.output
@

\paragraph{Where the item belongs}%
\label{sec:todo-view-parents}
An item may sit in several places (\cref{sec:todo-parents}), and the
sub-item listing of a parent shows only that the item is there, not
where else it is.  So [[view]] names the item's parents, the top level
among them, as \enquote{Parents: \#0 (top level), \#12 Course}: the id
for the user to type and the title for the user to recognise.  An item
that is only top-level has nothing to say here and gets no line, which
also leaves the view of an ordinary top-level item as it was.  A parent
that no longer exists is named as removed, as the provenance below
names a removed source.

<<collect metadata fields>>=
if parents_of(item) != [ROOT_ID]:
    fields.append(("Parents", format_parents(todos, item.parents)))
<<helpers>>=
def format_parents(todos, parent_ids):
    """Return `parent_ids` as ids and titles, such as
    `#0 (top level), #12 Course`."""
    by_id = {t.id: t for t in todos}
    words = []
    for parent_id in parent_ids:
        if parent_id == ROOT_ID:
            words.append(f"#{ROOT_ID} (top level)")
        elif parent_id in by_id:
            words.append(f"#{parent_id} {by_id[parent_id].title}")
        else:
            words.append(f"#{parent_id} (removed)")
    return ", ".join(words)
@

