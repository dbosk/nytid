        if item_type == "pr":
            gh_close_pr(
                gh["repo"], gh["number"]
            )
        else:
            gh_close_issue(
                gh["repo"], gh["number"]
            )
        changes += 1
        typer.echo(
            f"  #{item.id} closed on GitHub"
        )
    except Exception as e:
        typer.echo(
            f"  Warning: #{item.id} "
            f"close failed: {e}",
            err=True,
