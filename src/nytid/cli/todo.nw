The check for [[--prio]] reuses the single-parent one: the number
passes if one of the places holds it, and is otherwise refused with the
message for the first place.

<<child priority helpers>>=
def refuse_number_outside_places(
    todos: list[TodoItem],
    parents: list[TodoItem | None],
    number: float,
    subject: str,
    alternatives: str,
) -> None:
    """Exit with an error unless `number` lies inside the
    child range of one of `parents`.

    `None` stands for the top level, which takes any
    number, as does an unranked parent.
    """
    for parent in parents:
        bounds = child_priority_range_or_none(todos, parent)
        if bounds is None or bounds[1] < number < bounds[0]:
            return
    refuse_number_outside_range(
        todos, parents[0], number, subject, alternatives,
    )
