Both exit paths, the blocking one and the detached finalizer, stop a
run the same way, so the handling of a taken-over stop lives in one
function.  It stops the launcher's tracking of the item by naming the
launcher to [[stop_todo_tracking]], since the item's own session is
now the new claimant's.  Usually the takeover has already stopped
those labels and this stop finds nothing to do; it matters when the
launcher has started them again since, by hand.  The fourth value it
returns tells the caller whether there is an outcome to decide at
all.

<<helpers>>=
def stop_run(todo_id, launched_by=None):
    """Stop what a run of `todo_id` was tracking.

    Returns the resolved ID, the item (`None` if it is
    gone), the descendants that were stopped, and the
    worker who took the item over during the run (`None`
    if nobody did).  After a takeover only `launched_by`'s
    own tracking of the item is stopped and no
    descendants are touched.
    """
    try:
        (
            todo_id, item, _, _, _, descendants,
        ) = stop_todo_hierarchy(
            todo_id, launched_by=launched_by,
        )
    except RunTakenOver as taken:
        _, todos = load_todos()
        stop_todo_tracking(
            taken.todo_id, taken.item, todos,
            worker=launched_by,
        )
        typer.echo(
            f"  #{taken.todo_id} was taken over by "
            f"{taken.holder}; leaving it active"
        )
        return taken.todo_id, taken.item, [], taken.holder
    return todo_id, item, descendants, None
@

The detached helper uses it directly: it has no prompt, only the exit
code, so its decision is made at once from that.

<<helpers>>=
def finalize_detached_todo(
    todo_id, exit_code=1, exit_code_file=None,
    reassign_to=None, launched_by=None,
):
    """Finish a non-blocking tmux-backed todo run.

    `launched_by` is the worker that launched the run;
    see `stop_run` for what happens when the item has
    been taken over since.
    """
    if exit_code_file is not None:
        exit_code = read_detached_exit_code(
            exit_code_file
        )
    todo_id, item, descendants, _ = stop_run(
        todo_id, launched_by
    )
    if item is None:
        return

    exit_note = f"Exit code: {exit_code} (no output)"
    post_note_comment(item, exit_note)
    record_run_outcome(
        todo_id,
        {child.id for child in descendants},
        notes=[exit_note],
        reassign_to=(
            reassign_to if exit_code != 0 else None
        ),
        launched_by=launched_by,
    )


def run_todo_tmux_command(*args, **kwargs):
    """Delegate tmux launches to the track module helper."""
    from nytid.cli.track import run_tmux_command
    return run_tmux_command(*args, **kwargs)


def read_detached_exit_code(exit_code_file):
    """Read a tmux-recorded exit code for detached todo cleanup."""
    try:
        from nytid.cli.track import read_tmux_exit_status
        return read_tmux_exit_status(exit_code_file)
    except ImportError:
        return 1


def build_detached_todo_finalize_command(
    todo_id, proc_wd, exit_code_file,
    reassign_to=None, launched_by=None,
):
    """Return shell command to finalize a detached todo run."""
    pythonpath = os.path.abspath(
        os.path.join(
            os.path.dirname(__file__), "..", "..", ".."
        )
    )
    reassign_arg = (
        f" --reassign-to {shlex.quote(reassign_to)}"
        if reassign_to else ""
    )
    launcher_arg = (
        f" --launched-by {shlex.quote(launched_by)}"
        if launched_by else ""
    )
    return (
        f"PYTHONPATH={shlex.quote(pythonpath)} "
        f"{shlex.quote(sys.executable)} "
        "-c 'from nytid.cli.todo import cli; cli()' "
        f"_finalize-detached {todo_id} "
        f"--exit-code-file {shlex.quote(exit_code_file)}"
        f"{reassign_arg}{launcher_arg}"
        f"; rm -f {shlex.quote(exit_code_file)}"
    )
@

The reassignee has to travel through that shell string because the
finalizer runs in a fresh process minutes or hours later, long after
the [[start]] invocation that knew about [[--reassign-to]] has exited.
It is a user-supplied name interpolated into a command line, so it goes
through [[shlex.quote]] like every other value here; omitting the flag
entirely when there is no reassignee keeps the common case identical to
what tmux ran before.  The launching worker travels the same way and
for the same reason: the finalizer must know whose run it is ending
(\cref{sec:todo-run-taken-over}).

