Finally, the session itself.  While the editor is open, another
process adds a note to the parent and to the child, and a new child
under the parent.  The user changes only the title.  All three pieces
of concurrent work must survive the save: the notes because the
buffer left them as they were shown, and the new child because the
buffer never showed it.

The stored notes are tried both bare and with the trailing newline
that notes read from standard input carry.  The buffer loses that
newline, which must not count as the user editing the notes.

<<test functions>>=
@pytest.mark.parametrize("tail", ["", "\n"])
def test_edit_editor_keeps_concurrent_work(temp_todo_dir, tail):
    """Work stored during an edit -E session survives it."""
    from nytid.cli.todo import add, note
    save_todos(3, [
        TodoItem(
            id=1, title="Parent", priority=5.0,
            notes="First" + tail,
            created="2026-02-20T10:00:00",
        ),
        TodoItem(
            id=2, title="Child", parents=[1], priority=4.0,
            notes="Child notes" + tail,
            created="2026-02-20T10:00:00",
        ),
    ])

    def editor_meanwhile(text):
        note(1, message="Agent", edit=False)
        note(2, message="Agent too", edit=False)
        add(
            None, title="Agent child",
            parent=[1], explicit_priority=4.5,
        )
        return text.replace("Parent", "Renamed", 1)

    with patch(
        "nytid.cli.todo.open_editor",
        side_effect=editor_meanwhile,
    ):
        result = runner.invoke(cli, ["edit", "1", "-E"])

    assert result.exit_code == 0, result.stdout
    _, todos = load_todos()
    by_id = {t.id: t for t in todos}
    assert by_id[1].title == "Renamed"
    assert without_note_headers(
        by_id[1].notes
    ) == "First\n\nAgent"
    assert without_note_headers(
        by_id[2].notes
    ) == "Child notes\n\nAgent too"
    assert by_id[3].title == "Agent child"
