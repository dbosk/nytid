def test_export_vtodo(temp_todo_dir):
    """Test VTODO export."""
    save_todos(3, [
        TodoItem(
            id=1, title="Export me",
            priority=5.0,
            created="2026-02-20T10:00:00",
            estimated=2.0,
        ),
        TodoItem(
            id=2, title="Export me too",
            priority=None,
            created="2026-02-20T10:00:00",
        ),
    ])

    result = runner.invoke(
        cli, ["export", "--format", "vtodo"]
    )
    assert result.exit_code == 0
    # RFC 5545 requires VERSION and PRODID; icalendar does not add
    # them implicitly (the old ics library did).
    assert "VERSION:2.0" in result.stdout
    assert "PRODID" in result.stdout
    assert "VTODO" in result.stdout
    assert "Export me" in result.stdout
    assert "Export me too" in result.stdout


def test_export_vtodo_relates_every_parent(temp_todo_dir):
    """Each parent becomes a RELATED-TO;RELTYPE=PARENT."""
    save_todos(4, [
