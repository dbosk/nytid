    who: Annotated[str | None,
                   who_opt] = default_username,
):
    """Import GitHub issues/PRs as todo items.

    \b
    Examples:
      nytid todo import dbosk/prgi24-issues
      nytid todo import dbosk/prgi24-issues --wd ~/courses/DD1310/labs
      nytid todo import dbosk/nytid -n 42 --wd ~/devel/nytid --worktree fix-42
      nytid todo import dbosk/prgi24-issues --top-level --github-labels
    """
    require_gh()
    next_id, todos = load_todos()

    <<resolve import parent and inherited metadata>>
    <<resolve the import's [[discovered_from]]>>
    <<fetch github items>>
    <<filter already imported>>
    <<create todos from github items>>
    <<commit the imported todos under the lock>>
    <<report imported todos>>
    <<report skipped duplicates>>
