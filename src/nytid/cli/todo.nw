Let's verify both resume paths after a takeover.  Alice has the item
active with its labels suspended in her pane and in her window; the
user takes the item over; when Alice's pane or window regains focus,
neither the item's [[todo:]] label nor its course label comes back,
while a label of her own other active item does.

<<test functions>>=
def test_resume_skips_labels_of_taken_over_todo(
  temp_todo_dir,
):
  """Auto-suspend resume does not restart a taken todo."""
  from nytid.cli.track import (
    load_active_session,
    resume_tracking_labels,
    restart_window_batches,
    stop_tracking_labels_if_active,
    suspend_state_path,
    write_suspend_state,
  )
  save_todos(3, [
    TodoItem(
      id=1, title="Alice's task",
      created="2026-02-20T10:00:00",
      who="alice", labels=["DD1310"],
    ),
    TodoItem(
      id=2, title="Alice's other task",
      created="2026-02-20T10:00:00",
      who="alice", labels=["review"],
    ),
  ])
  runner.invoke(cli, ["start", "2", "--who", "alice"])
  runner.invoke(cli, ["start", "1", "--who", "alice"])
  taken = runner.invoke(cli, ["start", "1", "--force"])
  assert taken.exit_code == 0, taken.output

  stop_tracking_labels_if_active(
    who="alice", labels=["review"],
  )
  write_suspend_state(
    suspend_state_path("%3", "alice", "server0"),
    ["todo:1", "DD1310", "review"],
  )
  resume_tracking_labels("alice", "%3", "server0")
  restart_window_batches(
    who="alice", window_id="@1",
    tmux_server_key="server0",
    label_batches={"todo:1": 7, "DD1310": 7},
  )

  alice = load_active_session("alice").get_active_labels()
  assert "todo:1" not in alice
  assert "DD1310" not in alice
  assert "review" in alice
  mine = load_active_session(
    default_username
  ).get_active_labels()
  assert "todo:1" in mine
