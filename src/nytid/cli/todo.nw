def test_note_edit_while_another_note_lands(
    temp_todo_dir, edit_buffer, expected,
):
    """Only a changed buffer overwrites a concurrent note."""
    from nytid.cli.todo import note
    save_todos(2, [
        TodoItem(
            id=1, title="Local task",
            created="2026-02-20T10:00:00",
            notes="First",
