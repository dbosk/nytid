        ["start", "1", "--who", "alice",
         "--command", "true", *extra_args],
      )
    return result, confirm

  return run


def assert_kept_by_new_claimant():
  """The item is still the user's, active and tracked."""
  from nytid.cli.track import load_active_session
  assert load_active_stack() == [1]
  _, todos = load_todos()
  assert todos[0].claimed_by == default_username
  assert todos[0].who == "alice"
  assert todos[0].status == "in-progress"
  assert " alice]\nRun by alice ended after" in todos[0].notes
  mine = load_active_session(
    default_username
  ).get_active_labels()
  assert "todo:1" in mine
  alice = load_active_session("alice").get_active_labels()
  assert "todo:1" not in alice


def test_start_yes_after_takeover_leaves_item(
  run_taken_over_midway,
):
  """The old owner's 'mark done?' is not even asked."""
  result, confirm = run_taken_over_midway([])

  assert result.exit_code == 0, result.output
  confirm.assert_not_called()
  assert_kept_by_new_claimant()


def test_start_headless_after_takeover_leaves_item(
  run_taken_over_midway,
):
  """A failed headless run does not reassign a taken item."""
  result, _ = run_taken_over_midway(
    ["--headless", "--reassign-to", "teacher"]
  )

  assert result.exit_code == 0, result.output
  assert_kept_by_new_claimant()
  _, todos = load_todos()
  assert " alice]\nExit code: 1" in todos[0].notes
@

