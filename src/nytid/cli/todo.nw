<<resolve wd and env for new todo>>
resolved_who = who or default_username
estimated_hours = (
    parse_hours(estimate) if estimate else None
)
<<append the new todo under the lock>>

typer.echo(f"Added todo #{item.id}: {item.title}")
if len(item.parents) > 1:
    typer.echo(f"  Parents: {format_parents(todos, item.parents)}")
if inherited_labels:
    typer.echo(f"  Labels: {', '.join(inherited_labels)}")
if inherited_deadline:
