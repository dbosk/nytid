def finalize_detached_cmd(
    todo_id: Annotated[int, finalize_id_arg],
    exit_code: Annotated[int,
                         finalize_exit_arg] = 1,
    exit_code_file: Annotated[str | None,
                              finalize_file_opt] = None,
    reassign_to: Annotated[
        str | None, finalize_reassign_opt] = None,
    launched_by: Annotated[
        str | None, finalize_launcher_opt] = None,
):
    """Finalize a detached tmux-backed todo run."""
    finalize_detached_todo(
        todo_id, exit_code, exit_code_file,
        reassign_to, launched_by,
    )
@

Restarting an already-active task (e.g.\ after a failed run) must
not push a duplicate onto the stack, otherwise [[todo done]] would
only remove one copy and leave a stale entry.
[[activate_todo_state]] checks membership before appending.

Let's verify that starting a task pushes it onto the stack:

<<test functions>>=
def test_start_pushes_stack(temp_todo_dir):
    """Start pushes todo ID onto active stack."""
    save_todos(2, [
        TodoItem(
            id=1, title="Task",
            created="2026-02-20T10:00:00",
        ),
    ])
    result = runner.invoke(cli, ["start", "1"])
    assert result.exit_code == 0
    assert load_active_stack() == [1]


def test_start_defaults_to_active_todo(temp_todo_dir):
    """Start without ID uses the current active todo."""
    save_todos(3, [
        TodoItem(
            id=1, title="Parent task",
            created="2026-02-20T10:00:00",
        ),
        TodoItem(
            id=2, title="Active task",
            created="2026-02-20T10:00:00",
        ),
    ])
    save_active_stack([1, 2])

    result = runner.invoke(cli, ["start"])

    assert result.exit_code == 0
    assert "Started: #2 Active task" in result.output
    _, todos = load_todos()
    assert todos[1].status == "in-progress"
    assert load_active_stack() == [1, 2]


def test_start_syncs_status_from_active_stack(temp_todo_dir):
    """Starting one todo clears stale in-progress status on others."""
    save_todos(3, [
        TodoItem(
            id=1, title="Old active",
            created="2026-02-20T10:00:00",
            status="in-progress",
        ),
        TodoItem(
            id=2, title="New active",
            created="2026-02-20T10:00:00",
        ),
    ])
    result = runner.invoke(cli, ["start", "2"])
    assert result.exit_code == 0
    _, todos = load_todos()
    assert todos[0].status == "pending"
    assert todos[1].status == "in-progress"
    assert load_active_stack() == [2]


def test_start_without_id_requires_active_todo(temp_todo_dir):
    """Start without ID errors when no active todo exists."""
    save_todos(2, [
        TodoItem(
            id=1, title="Local task",
            created="2026-02-20T10:00:00",
        ),
    ])

    result = runner.invoke(cli, ["start"])

    assert result.exit_code == 1
    assert (
        "No active todo. Specify an ID to start."
        in result.output
