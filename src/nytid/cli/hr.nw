def employed_on(user, day):
  """
  Returns True if one of `user`'s contracts employs them on `day`, a
  `datetime.date`. Contracts without both employment dates are ignored.
  """
  for contract in get_user_contracts(user):
    start = contract_date_time(contract, "start")
    end = contract_date_time(contract, "end")
    if start and end and start.date() <= day <= end.date():
      return True
  return False
@

