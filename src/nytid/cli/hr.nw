  user_regex=contract["user"],
  course_regex=draft_courses,
  register=draft_register,
  start=start,
  end=end,
  push_start=push_start,
  set_start=set_start,
  set_end=set_end,
  detailed=detailed,
  event_summary=event_summary,
  draft=True,
  delimiter=delimiter
