The unit tests above exercise the row-building and template-filling in
isolation.  The remaining risk is in the wiring: the [[--xlsx]] chunk must feed
[[make_amanuensis_xlsx]] the \emph{resolved} dates (so [[--push-start]] is
honoured) and must hand it dates [[openpyxl]] accepts (the contract dates
arrive as timezone-aware datetimes, which [[openpyxl]] refuses).  We pin both
by driving
the [[create]] command end to end: we stub out the network-bound pieces
(course configs, the sign-up sheet, Canvas lookup) and the contract
computation, run with [[--push-start]], and read the written period start back
from the produced workbook.
<<test functions>>=
def test_cli_amanuens_create_xlsx_uses_pushed_dates(tmp_path, monkeypatch):
  """--xlsx must write the pushed contract dates, serialised for openpyxl."""
  import typerconf
  from openpyxl import load_workbook
  from typer.testing import CliRunner
  from nytid.cli import hr as hrcli

  booked = [
    _amanuensis_signup_row("DD1310 Övning",
                           "2024-09-02 10:00", "2024-09-02 12:00", ["alice"]),
  ]
  config = typerconf.Config({"signupsheet": {"url": "https://example.com/s.csv"},
                             "code": "DD1310"})

  def _no_canvas(*args, **kwargs):
    raise Exception("no Canvas in tests")

  monkeypatch.setattr(hrcli.coursescli, "get_courses_configs",
                      lambda *a, **k: {("DD1310", "reg"): config})
  monkeypatch.setattr(nytid.signup.sheets, "read_signup_sheet_from_url",
                      lambda url: booked)
  monkeypatch.setattr(hrcli, "get_canvas_user", _no_canvas)
  # Pin the contract to known dates so the date assertion is deterministic.
  # Aware local datetimes, matching what compute_amanuensis_data returns.
  monkeypatch.setattr(
    nytid.signup.hr, "compute_amanuensis_data",
    lambda *a, **k: {
      "alice": (datetime.datetime(2024, 9, 1).astimezone(),
                datetime.datetime(2024, 12, 1).astimezone(),
                100.0)})

  monkeypatch.chdir(tmp_path)
  result = CliRunner().invoke(
    hrcli.cli,
    ["amanuensis", "create", "--draft", "--xlsx",
     "--push-start", "2024-10-01"])

  assert result.exit_code == 0, result.output

  produced = list(tmp_path.glob("alice-*.xlsx"))
  assert len(produced) == 1

  ws = load_workbook(produced[0])["EXEMPEL"]
  # Pushing the start to 2024-10-01 shifts the whole period; the sheet must
  # show the pushed start, not the original 2024-09-01.
  written = ws["D10"].value
  written = written.date() if hasattr(written, "date") else written
  assert written == datetime.date(2024, 10, 1)
@

