  logging.warning(f"{contract['filename']}: no course in the register "
                  f"matches {draft_courses}, so there is no draft to "
                  "show.")
<<print the draft of [[contract]] from [[draft_courses]]>>=
start = contract_date_time(contract, "bookings_start") \
        or contract_date_time(contract, "start")
end = contract_date_time(contract, "bookings_end") \
      or contract_date_time(contract, "end")

try:
  push_start = datetime.datetime.fromisoformat(contract["push_start"]) \
            if contract["push_start"] else None
except KeyError:
  push_start = None

try:
  set_start = datetime.datetime.fromisoformat(contract["set_start"]) \
            if contract["set_start"] else None
except KeyError:
  set_start = None

try:
  set_end = datetime.datetime.fromisoformat(contract["set_end"]) \
            if contract["set_end"] else None
except KeyError:
