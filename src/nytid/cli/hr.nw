  """Piped period listings carry rows only, tab-separated."""
  from nytid.cli import hr as hrcli

  monkeypatch.setattr(
    hrcli, "get_all_periods",
    lambda: {"25/26-1": {"start": "2025-08-25",
                         "end": "2025-10-26"}})

  hrcli.cli_periods_list()

  assert capsys.readouterr().out == (
    "25/26-1\t2025-08-25\t2025-10-26\n")
