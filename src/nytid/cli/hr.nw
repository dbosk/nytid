  monkeypatch.setattr(hrcli, "get_all_periods", lambda: {
    "25/26-1": {"start": "2025-08-25", "end": "2025-10-26"},
    "25/26-2": {"start": "2025-10-27", "end": "2026-01-18"},
  })
  assert period_for_date(datetime.date(2025, 9, 1)) == "25/26-1"
  assert period_for_date(datetime.date(2025, 10, 27)) == "25/26-2"
  assert period_for_date(datetime.date(2026, 3, 1)) is None

def test_period_part_prefers_period_option():
  class Period:
    value = "25/26-3"
  start = datetime.datetime(2025, 9, 1).astimezone()
  assert period_part(Period(), start) == "P3"
