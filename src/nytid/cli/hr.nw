  rows = [
    _amanuensis_signup_row("Övning",
                           "2024-09-02 10:00", "2024-09-02 12:00", ["alice"]),
  ]
  # No config at all: division/period stay blank, kurskod falls back to the
  # course identifier, and we don't crash.
  course_rows = amanuensis_course_rows("alice", {("tilkry26", "reg"): rows}, {})
  assert course_rows[0]["kurskod"] == "tilkry26"
  assert course_rows[0]["avdelning"] == ""
  assert course_rows[0]["period"] == ""
