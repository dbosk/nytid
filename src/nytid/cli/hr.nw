Anything else has to reach the caller.
This is the test that the old [[except Exception]] cannot pass, and the
one that keeps the narrow catch honest:
<<test functions>>=
def test_ladok_session_propagates_unexpected_errors(ladok_stubs):
  """Surprises from ladok3 surface instead of becoming None."""
  from nytid.cli import hr as hrcli

  def explode():
    raise OSError("session cache is corrupt")

  ladok_stubs.ladok3.get_session = explode

  with pytest.raises(OSError):
