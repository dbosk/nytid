<<make all dates timezone aware>>=
<<make [[start]] and [[end]] timezone aware>>
if push_start:
  push_start = push_start.astimezone()
if set_start:
  set_start = set_start.astimezone()
if set_end:
  set_end = set_end.astimezone()
