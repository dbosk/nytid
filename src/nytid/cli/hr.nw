    hrcli.coursescli, "get_courses_configs",
    lambda *args, **kwargs: {
      ("DD1310", "reg"): typerconf.Config({})})
  monkeypatch.setattr(
    nytid.signup.hr, "hours_per_TA",
    lambda booked: {"alice": 10, "bob": 5})

  result = CliRunner().invoke(hrcli.cli,
                              ["employed", "ignore", "DD1310",
                               "alice"])

  assert result.exit_code == 0

  with storage.open_root(str(temp_employment_dir)) as root:
    records = get_employment_records(root)

  assert len(records) == 1
  assert records[0]["user"] == "alice"
  assert records[0]["ignored"]
  assert records[0]["valid_until"] is None
