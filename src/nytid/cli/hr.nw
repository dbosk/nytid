period_start, period_end = medvindcmds.default_period(
  medvindcmds.today(), medvindcmds.DEFAULT_CUTOFF_DAY)
start = start.date() if start else period_start
end = end.date() if end else period_end
<<exit unless we know the work [[leader]]>>=
