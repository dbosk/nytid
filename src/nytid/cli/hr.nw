  <<set list [[courses]] to ((course, register), config)-pairs>>
  <<let [[booked]] be all bookings from [[courses]]>>
  <<determine the [[valid_until]] date>>

  with employment_storage() as root:
    <<let [[missing_users]] be the booked TAs not covered>>
    for user in sorted(missing_users):
      <<print and store employment record for [[user]]>>
