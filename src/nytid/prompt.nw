def test_config_value_walks_dotted_key(tmp_path, monkeypatch):
    """A dotted key walks the nested JSON structure."""
    conf = tmp_path / "config.json"
    conf.write_text(json.dumps(
        {"todo": {"data_dir": "/somewhere/todos"}}
    ))
    monkeypatch.setattr(
        nytid.prompt, "config_file", lambda: conf
