    `nytid.cli.todo`: stack order is kept; ids missing from
    `todos.json`, ids whose status is `done`, and duplicates
    are dropped.  Missing or corrupt files yield empty results.
    """
    directory = todo_dir()
    <<read the todo statuses>>
    <<read and normalize the raw stack>>
    return parent_by_id, normalized


def active_todo_ids():
    """Return the ids of the active todos, in stack order.

    See `todo_state` for the normalization rule.
    """
    _, active = todo_state()
    return active
