def test_active_todo_ids_matches_real_reader(prompt_dirs):
    """Drift guard: our reader agrees with `load_todo_state`."""
    todo_path, _ = prompt_dirs
    todos = [
        real_todo.TodoItem(
            id=1, title="pending one",
            created="2026-08-25T10:00:00",
        ),
        real_todo.TodoItem(
            id=2, title="done one", status="done",
            created="2026-08-25T10:00:00",
        ),
        real_todo.TodoItem(
            id=3, title="pending two",
            created="2026-08-25T10:00:00",
        ),
    ]
    real_todo.save_todo_state_unlocked(4, todos, [3, 1])
    stale = [3, 2, 99, 3, 1]
